generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(cuid())
  username          String    @unique
  email             String    @unique
  password          String
  resetToken           String?
  resetTokenExpires    DateTime?
  role                 String    @default("USER")
  emailVerified        Boolean   @default(false)
  verificationToken    String?
  verificationTokenExp DateTime?
  onboardingCompleted  Boolean   @default(false)
  twoFactorEnabled     Boolean   @default(false)
  twoFactorSecret      String?
  profile              Json?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  ownedProjects   Project[]      @relation("ProjectOwner")
  collaborations  Collaborator[]
  sentInvitations Invitation[]   @relation("InvitationSender")
  activityLogs    ActivityLog[]
  feedbacks       Feedback[]
  notebookEntries NotebookEntry[]

  @@map("users")
}

model Project {
  id          String        @id @default(cuid())
  name        String
  description String?
  metadata    Json?
  status      ProjectStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  ownerId       String
  owner         User           @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  collaborators Collaborator[]
  invitations   Invitation[]
  studies       Study[]
  activityLogs  ActivityLog[]

  @@map("projects")
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

model Collaborator {
  id       String           @id @default(cuid())
  role     CollaboratorRole @default(EDITOR)
  joinedAt DateTime         @default(now())

  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@map("collaborators")
}

enum CollaboratorRole {
  EDITOR
  VIEWER
}

model Invitation {
  id        String           @id @default(cuid())
  email     String
  role      CollaboratorRole @default(EDITOR)
  token     String           @unique @default(cuid())
  expiresAt DateTime
  accepted  Boolean          @default(false)
  createdAt DateTime         @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User    @relation("InvitationSender", fields: [senderId], references: [id])

  @@map("invitations")
}

model Study {
  id          String      @id @default(cuid())
  name        String
  description String?
  status      StudyStatus @default(DRAFT)
  version     Int         @default(1)
  metadata    Json?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  projectId String
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  blocks    Block[]
  versions  StudyVersion[]

  design              ExperimentalDesign?
  participantSessions ParticipantSession[]
  notebookEntries     NotebookEntry[]
  freezes             StudyFreeze[]
  preregistration     Preregistration?

  @@map("studies")
}

// ─── PRÉENREGISTREMENT ───────────────────────────────────────────────────────
// Un préenregistrement par étude (modèle OSF Preregistration). Brouillon
// modifiable, puis VERROUILLÉ : date et heure du serveur, empreinte du texte,
// plus aucune modification possible (on ajoute des amendements datés).
// Un préenregistrement verrouillé SURVIT à la suppression de l'étude ou du
// compte (studyId passe à null) : il reste consultable par ses liens. Les
// brouillons orphelins sont supprimés avec l'étude. Seul un administrateur
// peut le RETIRER, à la demande des auteurs : contenu effacé, avis de retrait
// daté et motivé à la place. Voir lib/prereg.js.
model Preregistration {
  id            String    @id @default(cuid())
  template      String    @default("OSF")
  language      String    @default("fr")    // fr | en : titres du PDF, textes pré-remplis
  status        String    @default("DRAFT") // DRAFT | LOCKED
  answers       Json      @default("{}")    // { cléQuestion: réponse }
  authors       Json      @default("[]")    // [{ name, affiliation, email }]
  // État de l'étude au verrouillage (objectif, conditions, mesures,
  // participants déjà inscrits, empreinte du matériel) : sert à détecter les
  // écarts au préenregistrement.
  structure     Json?
  fingerprint   String?
  lockedAt      DateTime?
  lockedByName  String?
  // Liens de consultation : relecteur anonyme (sans les auteurs) et public
  // (désactivé par défaut).
  reviewToken   String?   @unique
  publicToken   String?   @unique
  publicEnabled Boolean   @default(false)
  // Retrait à la demande des auteurs (fait par un administrateur) : le
  // contenu est effacé, les liens affichent la date et le motif du retrait.
  withdrawnAt      DateTime?
  withdrawalReason String?
  // Premier export des données après le verrouillage : sert à dater les
  // écarts (avant ou après un premier accès aux données).
  firstDataExportAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  studyId String? @unique
  study   Study?  @relation(fields: [studyId], references: [id], onDelete: SetNull)

  amendments PreregAmendment[]
  deviations PreregDeviation[]

  @@map("preregistrations")
}

// Amendement d'un préenregistrement verrouillé : daté, jamais modifié.
// Écart au préenregistrement : annotation du chercheur sur un écart détecté
// par MindCraft (key = clé de l'écart, ex. « MESURE_SUPPRIMEE:Q3 ») ou écart
// déclaré à la main (key vide, description saisie). Modifiable : c'est le
// rapport d'écarts de l'article, mis au point jusqu'à la publication.
// Voir lib/deviations.js.
model PreregDeviation {
  id            String   @id @default(cuid())
  key           String?
  category      String   // MAJEUR | MINEUR | PRECISION | SANS_OBJET
  description   String?  // écart déclaré à la main (écart détecté : calculé)
  moment        String?
  reason        String   @default("")
  impact        String   @default("")
  updatedByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  preregId String
  prereg   Preregistration @relation(fields: [preregId], references: [id], onDelete: Cascade)

  @@unique([preregId, key])
  @@map("prereg_deviations")
}

model PreregAmendment {
  id         String   @id @default(cuid())
  category   String   // PRECISION | MINEUR | MAJEUR
  content    String
  authorName String?
  createdAt  DateTime @default(now())

  preregId String
  prereg   Preregistration @relation(fields: [preregId], references: [id], onDelete: Cascade)

  @@index([preregId, createdAt])
  @@map("prereg_amendments")
}

// ─── CAHIER DE LABORATOIRE ───────────────────────────────────────────────────
// Une entrée par événement de l'étude, manuelle (passation, écart, décision,
// incident, note) ou automatique (statut, modification pendant la collecte,
// réinitialisation, objectif / délai d'abandon). Une entrée n'est JAMAIS
// modifiée ni supprimée : on ajoute une correction qui la cite (correctsId).
model NotebookEntry {
  id             String   @id @default(cuid())
  kind           String   // PASSATION | ECART | DECISION | INCIDENT | NOTE | AUTO
  autoEvent      String?  // si AUTO : STATUS | MODIFICATION | RESET | DESIGN | GEL | PREREG | AMENDEMENT | PREREG_RETRAIT
  content        String
  // Objet lié (ex. id du StudyFreeze pour un événement GEL).
  refId          String?
  participantIds Json     @default("[]")
  // Nom de l'auteur figé à l'écriture : l'entrée reste lisible même si le
  // compte est supprimé. Vide pour les entrées automatiques sans auteur.
  authorName     String?
  createdAt      DateTime @default(now())

  studyId     String
  study       Study          @relation(fields: [studyId], references: [id], onDelete: Cascade)
  authorId    String?
  author      User?          @relation(fields: [authorId], references: [id], onDelete: SetNull)
  correctsId  String?
  corrects    NotebookEntry? @relation("NotebookCorrections", fields: [correctsId], references: [id], onDelete: SetNull)
  corrections NotebookEntry[] @relation("NotebookCorrections")

  @@index([studyId, createdAt])
  @@map("notebook_entries")
}

// ─── GEL DU MATÉRIEL ─────────────────────────────────────────────────────────
// Copie complète de l'étude au lancement de la collecte (premier participant,
// ou premier après une réinitialisation des données), avec l'empreinte de son
// matériel. Jamais modifiée. Voir lib/freeze.js.
model StudyFreeze {
  id          String   @id @default(cuid())
  version     Int
  fingerprint String
  snapshot    Json
  // Participants déjà inscrits avant le gel : 0 au lancement de la collecte ;
  // > 0 pour une étude déjà en collecte quand le gel a été mis en place.
  priorSessions Int    @default(0)
  createdAt   DateTime @default(now())

  studyId String
  study   Study  @relation(fields: [studyId], references: [id], onDelete: Cascade)

  @@index([studyId, createdAt])
  @@map("study_freezes")
}

enum StudyStatus {
  DRAFT
  REVIEW
  VALIDATED
  COLLECTING
  ARCHIVED
}

model StudyVersion {
  id        String   @id @default(cuid())
  version   Int
  snapshot  Json
  createdAt DateTime @default(now())

  studyId String
  study   Study  @relation(fields: [studyId], references: [id], onDelete: Cascade)

  @@map("study_versions")
}

model Block {
  id        String    @id @default(cuid())
  type      BlockType
  label     String?
  order     Int
  settings  Json      @default("{}")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  studyId   String
  study          Study               @relation(fields: [studyId], references: [id], onDelete: Cascade)
  questions      Question[]
  stimulusFiles  StimulusFile[]
  sequenceSteps  TrialSequenceStep[]

  @@map("blocks")
}

enum BlockType {
  WELCOME
  INSTRUCTION
  QUESTION
  STIMULUS
  LOGIC
  DEBRIEFING
}

model Question {
  id        String       @id @default(cuid())
  code      String?
  type      QuestionType
  text      String
  required  Boolean      @default(true)
  randomize Boolean      @default(false)
  order     Int
  settings  Json         @default("{}")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  blockId     String
  block       Block        @relation(fields: [blockId], references: [id], onDelete: Cascade)
  choices     Choice[]
  matrixItems MatrixItem[]
  conditions  Condition[]

  @@map("questions")
}

enum QuestionType {
  // ── Choix unique ─────────────────────────────────────────────────────
  RADIO
  SELECT
  BUTTON_GROUP
  MEDIA_RADIO
  RADIO_COMMENT
  DRILL_DOWN
  // ── Choix multiple ────────────────────────────────────────────────────
  CHECKBOX
  MEDIA_CHECKBOX
  CHECKBOX_COMMENT
  // ── Texte libre ───────────────────────────────────────────────────────
  TEXT
  INPUT_DEMAND
  FILL_BLANK
  WORD_LIST
  // ── Échelles & sliders ────────────────────────────────────────────────
  LIKERT
  MATRIX
  SLIDER
  SEMANTIC_DIFF
  SIDE_BY_SIDE
  CONSTANT_SUM
  // ── Numérique ─────────────────────────────────────────────────────────
  NUMERIC
  EQUATION
  COMPUTED
  // ── Affichage (sans collecte) ─────────────────────────────────────────
  DISPLAY
  IMAGE
  AUDIO
  VIDEO
  // ── Spécial ───────────────────────────────────────────────────────────
  RANKING
  DATE
  FILE_UPLOAD
  TIMING
  HOTSPOT
  DRAG_DROP
  DROP_WORD
  HIGHLIGHT
  RANDOM_CODE
  META_INFO
  // ── Autre ─────────────────────────────────────────────────────────────
  CONSENT
}

model Choice {
  id        String  @id @default(cuid())
  code      String
  label     String
  order     Int
  anchored  Boolean @default(false)
  mediaUrl  String?
  mediaType String?

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("choices")
}

model MatrixItem {
  id       String  @id @default(cuid())
  code     String
  label    String
  order    Int
  reversed Boolean @default(false)
  left     String?
  right    String?

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("matrix_items")
}

model Condition {
  id            String  @id @default(cuid())
  sourceCode    String
  operator      String
  value         String
  targetBlockId String?

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("conditions")
}

model ActivityLog {
  id        String   @id @default(cuid())
  action    String
  details   String?
  createdAt DateTime @default(now())

  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("activity_logs")
}

// ─── STIMULI ──────────────────────────────────────────────────────────────────

model StimulusFile {
  id           String   @id @default(cuid())
  filename     String
  originalName String
  mimetype     String
  size         Int
  url          String
  data         Bytes?
  category     String?
  createdAt    DateTime @default(now())

  blockId String
  block   Block  @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@map("stimulus_files")
}

model TrialSequenceStep {
  id       String @id @default(cuid())
  type     String
  order    Int
  settings Json   @default("{}")

  blockId String
  block   Block  @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@map("trial_sequence_steps")
}

model TrialResponse {
  id            String   @id @default(cuid())
  participantId String
  studyId       String
  blockId       String
  trialIndex    Int
  stimulusFile  String?
  stimulusCategory String?
  keyPressed    String?
  correct       Boolean?
  rtMs          Float?
  response      Json?
  phase         String?  // 'TRAINING' | 'TEST' | null (legacy / single-phase)
  phaseName     String?  // Libellé de la phase (utile si plusieurs blocs de test)
  createdAt     DateTime @default(now())

  @@map("trial_responses")
}

// ─── PHASE 4 : DESIGN EXPÉRIMENTAL ──────────────────────────────────────────

enum DesignType {
  BETWEEN
  WITHIN
  MIXED
  NONE   // Étude non expérimentale (pas de manipulation, pas de facteurs).
         // Permet d'enregistrer un objectif d'échantillon (design.targetN)
         // et de suivre la progression du recrutement même sans plan factoriel.
}

enum CounterbalanceMethod {
  LATIN_SQUARE
  WILLIAMS
  RANDOM
}

enum QuotaMode {
  STRICT
  SOFT
}

enum SessionStatus {
  ALLOCATED
  IN_PROGRESS
  COMPLETED
  ABANDONED
  EXCLUDED
}

model ExperimentalDesign {
  id                   String              @id @default(cuid())
  designType           DesignType
  counterbalanceMethod CounterbalanceMethod @default(LATIN_SQUARE)
  quotaMode            QuotaMode            @default(STRICT)
  targetN              Int                  @default(30)
  settings             Json                 @default("{}")
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  studyId String @unique
  study   Study  @relation(fields: [studyId], references: [id], onDelete: Cascade)

  factors Factor[]

  @@map("experimental_designs")
}

model Factor {
  id        String   @id @default(cuid())
  name      String
  type      String   // "BETWEEN" or "WITHIN"
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  designId String
  design   ExperimentalDesign @relation(fields: [designId], references: [id], onDelete: Cascade)

  levels FactorLevel[]

  @@map("factors")
}

model FactorLevel {
  id       String @id @default(cuid())
  name     String
  code     String
  order    Int
  blockIds Json   @default("[]")

  factorId String
  factor   Factor @relation(fields: [factorId], references: [id], onDelete: Cascade)

  conditionAssignments ConditionAssignment[]

  @@map("factor_levels")
}

model ParticipantSession {
  id                  String        @id @default(cuid())
  participantId       String
  status              SessionStatus @default(ALLOCATED)
  counterbalanceIndex Int
  blockOrder          Json          @default("[]")
  metadata            Json          @default("{}")
  allocatedAt         DateTime      @default(now())
  startedAt           DateTime?
  completedAt         DateTime?

  studyId String
  study   Study  @relation(fields: [studyId], references: [id], onDelete: Cascade)

  conditionAssignments ConditionAssignment[]
  randomCodes          RandomCode[]

  @@unique([studyId, participantId])
  @@map("participant_sessions")
}

// Code aléatoire attribué à un participant (question RANDOM_CODE). Tiré par
// le serveur ; l'unicité dans l'étude (par question) est garantie par la base.
// Supprimé avec la session (réinitialisation des données). Voir lib/randomCode.js.
model RandomCode {
  id           String   @id @default(cuid())
  studyId      String
  questionCode String
  code         String
  createdAt    DateTime @default(now())

  sessionId String
  session   ParticipantSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([studyId, questionCode, code])
  @@unique([sessionId, questionCode])
  @@map("random_codes")
}

model ConditionAssignment {
  id String @id @default(cuid())

  sessionId String
  session   ParticipantSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  factorLevelId String
  factorLevel   FactorLevel @relation(fields: [factorLevelId], references: [id], onDelete: Cascade)

  @@unique([sessionId, factorLevelId])
  @@map("condition_assignments")
}

// ─── FEEDBACK UTILISATEURS ──────────────────────────────────────────────────

enum FeedbackType {
  BUG
  SUGGESTION
  FEATURE
}

enum FeedbackStatus {
  OPEN
  SEEN
  RESOLVED
}

model Feedback {
  id          String         @id @default(cuid())
  type        FeedbackType
  message     String
  page        String?
  status      FeedbackStatus @default(OPEN)
  createdAt   DateTime       @default(now())
  adminReply  String?        // Réponse rédigée par l'admin (envoyée par email + visible côté utilisateur)
  repliedAt   DateTime?      // Horodatage de la réponse admin

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("feedbacks")
}

// ─── FICHIERS MÉDIAS (questions image/audio/vidéo, tâches HTML externes) ────

model MediaFile {
  id           String   @id @default(cuid())
  filename     String   @unique
  originalName String
  mimetype     String
  size         Int
  data         Bytes
  createdAt    DateTime @default(now())

  @@map("media_files")
}

// ─── PHASE 5 : RÉPONSES QUESTIONS ───────────────────────────────────────────

model QuestionResponse {
  id            String   @id @default(cuid())
  participantId String
  studyId       String
  blockId       String
  questionCode  String
  value         Json
  // Temps de réponse (ms) : délai entre l'affichage de la page et la dernière
  // modification de la réponse. Optionnel : absent pour les données
  // antérieures à cette colonne.
  rtMs          Int?
  createdAt     DateTime @default(now())

  @@index([studyId, participantId])
  @@map("question_responses")
}

// ─── PHASE 5b : RÉPONSES TÂCHES EXTERNES ────────────────────────────────────

model ExternalTaskResponse {
  id            String   @id @default(cuid())
  participantId String
  studyId       String
  blockId       String
  data          Json     // Tableau complet des résultats envoyé par la tâche externe
  createdAt     DateTime @default(now())

  @@index([studyId, participantId])
  @@map("external_task_responses")
}

// ─── PHASE 5c : VISITES DE PAGE (TIMING PAR BLOC) ──────────────────────────
//
// Enregistre l'heure d'arrivée d'un·e participant·e sur chaque bloc. Permet
// au chercheur·euse, à l'export, de calculer le temps passé sur chaque page
// (via des soustractions entre visites successives) — utile pour détecter
// les passations bâclées et appliquer des critères d'exclusion temporels.
//
// Toujours enregistré, l'inclusion dans le CSV est optionnelle (via une
// case à cocher dans l'onglet Export).

model PageVisit {
  id            String   @id @default(cuid())
  participantId String
  studyId       String
  blockId       String
  visitedAt     DateTime @default(now())

  @@index([studyId, participantId])
  @@map("page_visits")
}
